# ==========================================
# KBZ Bank Inbound Remittance Portal - Environment Variables
# ==========================================

# Application & Server Configuration
NODE_ENV="development"
PORT=3000

# ------------------------------------------
# Database Connection (Neon / PostgreSQL)
# ------------------------------------------
# Replace with your PostgreSQL connection URI (e.g. from Neon, Supabase, Cloud SQL)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------
# Security & Authentication
# ------------------------------------------
# Secret key used for signing JWT access and 2FA verification tokens
JWT_SECRET="your-super-secret-jwt-signing-key-minimum-32-chars"

# Salt key used for secure password hashing and encryption
AUTH_SALT="your-super-secret-auth-salt-string"

# ------------------------------------------
# SMTP Email Service (for 2FA OTP codes)
# ------------------------------------------
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_ENCRYPTION="tls"
MAIL_USERNAME="your-email@domain.com"
MAIL_PASSWORD="your-smtp-app-password"
MAIL_FROM_ADDRESS="no-reply@kbzbank.com"
MAIL_FROM_NAME="KBZ Bank IR Portal"
MAIL_TO_ADDRESS=""

# ------------------------------------------
# Database Seeding
# ------------------------------------------
# Set to 'true' if you want the server to auto-seed default transactions and tables on startup
ENABLE_DB_SEED=false

# ------------------------------------------
# Foreign Exchange (FX) Rates Feed
# ------------------------------------------
# Live Central Bank of Myanmar (CBM) exchange rates API
CBM_FOREX_API_URL="https://forex.cbm.gov.mm/api/latest"
